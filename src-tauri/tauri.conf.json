{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notch",
  "version": "1.0.0",
  "identifier": "id.notch.desktopwidget",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Notch top overlay",
        "url": "overlay.html",
        "width": 1920,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true,
        "shadow": false,
        "focusable": false,
        "center": false
      },
      {
        "label": "notch",
        "title": "Dynamic Island",
        "url": "index.html",
        "width": 900,
        "height": 110,
        "minWidth": 180,
        "minHeight": 50,
        "maxWidth": 900,
        "maxHeight": 110,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true,
        "shadow": false,
        "focusable": false,
        "center": true
      },
      {
        "label": "control-toggle",
        "title": "Control Center",
        "url": "toggle.html",
        "width": 48,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true,
        "shadow": false,
        "center": false
      },
      {
        "label": "control-center",
        "title": "Control Center",
        "url": "control-center.html",
        "width": 400,
        "height": 680,
        "minWidth": 360,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "center": false
      },
      {
        "label": "settings",
        "title": "Pengaturan Notch",
        "url": "settings.html",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 620,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
